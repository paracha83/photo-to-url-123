# ==============================================================================
# SERVER CONFIGURATION & STORAGE
# (NEVER expose secrets to browser / NEVER prefix with VITE_)
# ==============================================================================

# PRIMARY & DEFAULT STORAGE PROVIDER: LocalStorageProvider
# Set to "local" (or leave empty). No R2 credentials or payment cards required.
STORAGE_PROVIDER="local"

# OPTIONAL CLOUDFLARE R2 / S3 CLOUD STORAGE
# Only evaluated if STORAGE_PROVIDER is explicitly set to "r2" or "s3".
# In local mode (default), these variables are completely optional and ignored.
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_BUCKET_NAME="image-to-url-uploads"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_PUBLIC_URL="https://img.yourcustomdomain.com"

# Alternative S3 variable names (also supported if STORAGE_PROVIDER="s3"):
# STORAGE_BUCKET="image-to-url-uploads"
# STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# STORAGE_ACCESS_KEY="your_access_key_id"
# STORAGE_SECRET_KEY="your_secret_access_key"
# STORAGE_REGION="auto"
# STORAGE_PUBLIC_DOMAIN="https://img.yourcustomdomain.com"

# APPLICATION SECURITY & ADMINISTRATION (Server-side only)
# Required in production for administrative deletion/purges.
ADMIN_SECRET="generate_a_random_strong_secret_key"
GEMINI_API_KEY="your_gemini_api_key_for_smart_alt_text"

# SERVER-SIDE LIMITS & CONTROLS
MAX_UPLOAD_SIZE=10485760    # 10 MB in bytes
UPLOAD_RATE_LIMIT=20        # Max uploads per minute per IP

# ==============================================================================
# CLIENT-SAFE / PUBLIC APPLICATION CONFIGURATION
# ==============================================================================
APP_URL="http://localhost:3000"
